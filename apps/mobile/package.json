{
  "name": "@deck/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "check": "bun run typecheck && bun run lint",
    "test": "bun test src",
    "doctor": "bunx expo-doctor",
    "export:android": "expo export --platform android",
    "prebuild:android": "expo prebuild --platform android --no-install"
  },
  "dependencies": {
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@shopify/flash-list": "2.0.2",
    "expo": "~57.0.30",
    "expo-camera": "~57.0.6",
    "expo-dev-client": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-passkeys": "0.4.2",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "1.1.8",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.4",
    "@types/bun": "^1.4.3",
    "@types/node": "^22",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.16",
    "typescript": "~6.0.3"
  }
}
