{
  "name": "deck-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Deck desktop: a window onto the agents of a running Deck",
  "homepage": "https://github.com/dev-dami/deck",
  "author": {
    "name": "dev-dami",
    "email": "141376183+dev-dami@users.noreply.github.com"
  },
  "main": "dist/app/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.main.json && node -e \"require('fs').cpSync('../proto/deck/v1/deck.proto', 'dist/app/proto/deck.proto')\"",
    "build:deck": "node scripts/build-deck.mjs",
    "dist": "npm run build && npm run build:deck && electron-builder",
    "start": "electron .",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "smoke": "npm run build && electron . --smoke",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.6",
    "@grpc/proto-loader": "0.8.1",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.10",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.18.12",
    "@types/prismjs": "1.26.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.0.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "44.9.0",
    "electron-builder": "26.17.0",
    "lucide-react": "1.49.0",
    "prismjs": "1.30.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "dev.deck.desktop",
    "productName": "Deck",
    "directories": {
      "output": "release"
    },
    "protocols": [
      {
        "name": "Deck",
        "schemes": [
          "deck"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "dev-dami",
        "repo": "deck-releases"
      }
    ],
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "deck",
          "deck.exe",
          "relay-dir.txt"
        ]
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
