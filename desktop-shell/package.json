{
  "name": "deck-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Deck desktop: a window onto the agents of a running Deck",
  "main": "dist/app/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.main.json",
    "start": "electron .",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "smoke": "npm run build && electron . --smoke",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json"
  },
  "dependencies": {
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.12",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "38.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3",
    "vite": "7.1.10",
    "vitest": "3.2.4"
  }
}
